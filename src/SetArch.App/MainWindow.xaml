<Window x:Class="SetArch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SetArch.App"
        xmlns:models="clr-namespace:SetArch.Core.Models;assembly=SetArch.Core"
        xmlns:planning="clr-namespace:SetArch.Core.Planning;assembly=SetArch.Core"
        Title="SetArch - New Project Setup"
        Width="1150" Height="780" MinWidth="950" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13.5">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Rail}" Padding="24,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="SetArch" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="  ·  set up a new project from your office standards" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="Tabs" Padding="0" BorderThickness="0,1,0,0" SelectionChanged="Tabs_SelectionChanged">

            <!-- ================================================================ NEW PROJECT -->
            <TabItem Header="  New project  ">
                <Grid Margin="24,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="150"/>
                    </Grid.RowDefinitions>

                    <!-- Questions -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitle}" Text="Project details"/>
                            <TextBlock Style="{StaticResource PageIntro}" Text="These replace the placeholders in your folder names, file names and drawings."/>

                            <ItemsControl ItemsSource="{Binding Fields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Placeholder}" Foreground="{StaticResource Muted}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Bottom"/>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                            </DockPanel>
                                            <Grid>
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MaxWidth="10000"
                                                         Visibility="{Binding HasOptions, Converter={x:Static local:InverseBoolToVisibility.Instance}}"/>
                                                <ComboBox IsEditable="True" ItemsSource="{Binding Options}" MaxWidth="10000"
                                                          Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                          Visibility="{Binding HasOptions, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Create the project in" FontWeight="SemiBold" Margin="0,8,0,3"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0" Click="BrowseParent_Click"/>
                                <TextBox Text="{Binding ParentFolder, UpdateSourceTrigger=PropertyChanged}" MaxWidth="10000"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="e.g. your Projects folder on the server. The project folder is created inside it."/>

                            <TextBlock Text="Drawings" FontWeight="SemiBold" Margin="0,16,0,0"/>
                            <CheckBox IsChecked="{Binding FillDrawings}" IsEnabled="{Binding CanFillAutomatically}"
                                      Content="Fill in the placeholders in the drawings (uses AutoCAD in the background)"/>
                            <CheckBox IsChecked="{Binding WriteLtLisp}" Content="Also save a SetArch Fill.lsp in the project (for AutoCAD LT)"/>
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding ConsoleStatus}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Preview -->
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="What will be created"/>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Messages}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#9A3412" Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border DockPanel.Dock="Top" BorderBrush="#C9D2DA" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Title block" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding TitleBlockPreview}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="230"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Value}" Foreground="{StaticResource Muted}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Open project folder" Click="OpenProject_Click" Margin="0,0,8,0"
                                    Visibility="{Binding HasLastProject, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Create project" Style="{StaticResource Primary}" Padding="18,8" FontSize="15"
                                    IsEnabled="{Binding CanCreate}" Click="Create_Click"/>
                        </StackPanel>
                        <Border BorderBrush="#E3E7EB" BorderThickness="1" CornerRadius="4">
                            <TreeView ItemsSource="{Binding PreviewRoots}" BorderThickness="0" Padding="4">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="True"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type planning:PreviewNode}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <TextBlock Text="{Binding Converter={x:Static local:PreviewIcon.Instance}}" Width="22"/>
                                            <TextBlock Text="{Binding Name}"/>
                                            <TextBlock Text="  · text filled in" Foreground="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center"
                                                       Visibility="{Binding Fill, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Border>
                    </DockPanel>

                    <TextBox x:Name="LogBox" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" Text="{Binding Log, Mode=OneWay}"
                             IsReadOnly="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap" MaxWidth="10000" Background="#FAFBFC" TextChanged="LogBox_TextChanged"/>
                </Grid>
            </TabItem>

            <!-- ================================================================ STANDARDS -->
            <TabItem Header="  My standards  ">
                <DockPanel Margin="24,18">
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Import standards..." Click="ImportStandards_Click"/>
                            <Button Content="Export standards..." Margin="8,0,0,0" Click="ExportStandards_Click"/>
                            <Button Content="Reset to example" Margin="8,0,0,0" Click="ResetStandards_Click"/>
                        </StackPanel>
                        <Button Content="Save standards" Style="{StaticResource Primary}" HorizontalAlignment="Right" Click="SaveStandards_Click"/>
                    </DockPanel>

                    <TabControl>
                        <!-- Folder tree -->
                        <TabItem Header="Folder structure">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="300"/>
                                </Grid.ColumnDefinitions>
                                <TreeView x:Name="FolderTree" ItemsSource="{Binding RootNodes}" SelectedItemChanged="FolderTree_SelectedItemChanged">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="True"/>
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type models:FolderNode}" ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                <TextBlock Text="📁" Width="22"/>
                                                <TextBlock Text="{Binding Name}"/>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Selected folder name" FontWeight="SemiBold"/>
                                    <TextBox x:Name="FolderNameBox" Margin="0,4,0,0" MaxWidth="10000"/>
                                    <Button Content="Rename" Margin="0,6,0,0" HorizontalAlignment="Left" Click="RenameFolder_Click"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="Names can use placeholders, e.g. [[PROJECT_NUMBER]] - [[PROJECT_NAME]]. The top folder is the project folder itself."/>

                                    <Button Content="Add subfolder" Margin="0,18,0,0" HorizontalAlignment="Left" Click="AddFolder_Click"/>
                                    <Button Content="Delete folder" Margin="0,6,0,0" HorizontalAlignment="Left" Click="DeleteFolder_Click"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Move up" Click="MoveFolderUp_Click"/>
                                        <Button Content="Move down" Margin="6,0,0,0" Click="MoveFolderDown_Click"/>
                                    </StackPanel>

                                    <TextBlock Text="Already have a template folder?" FontWeight="SemiBold" Margin="0,24,0,0"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="Copy its folder tree (and optionally its files) into your standards."/>
                                    <Button Content="Import from a folder..." Margin="0,6,0,0" HorizontalAlignment="Left" Click="ImportTree_Click"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <!-- Template files -->
                        <TabItem Header="Template files">
                            <DockPanel Margin="12">
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8" TextWrapping="Wrap"
                                           Text="Your standard files (title block, cover sheet, sheets, spreadsheets ...). Each is copied into the chosen folder. In drawings, text, MTEXT and attributes containing placeholders like [[PROJECT_NAME]] are filled in, and attributes tagged with a field name (e.g. PROJECT_NAME) get that value."/>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Add files..." Click="AddFiles_Click"/>
                                    <Button Content="Remove selected" Margin="8,0,0,0" Click="RemoveFiles_Click"/>
                                </StackPanel>
                                <DataGrid x:Name="FilesGrid" ItemsSource="{Binding Profile.Files}" AutoGenerateColumns="False" CanUserAddRows="False"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E3E7EB"
                                          RowHeight="30" CellEditEnding="Grid_CellEditEnding">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Template file" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="..." MinWidth="28" Padding="4,0" Click="BrowseTemplate_Click"/>
                                                        <TextBlock Text="{Binding SourcePath}" ToolTip="{Binding SourcePath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Put in folder" Width="1.5*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.FolderPaths, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedValuePath="Value" DisplayMemberPath="Name" MaxWidth="10000" BorderThickness="0"
                                                              SelectedValue="{Binding Folder, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Save as" Binding="{Binding FileName}" Width="1.6*"/>
                                        <DataGridCheckBoxColumn Header="Fill text" Binding="{Binding FillText, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                        <DataGridTemplateColumn Header="Only for project type" Width="1.2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox IsEditable="True" MaxWidth="10000" BorderThickness="0"
                                                              ItemsSource="{Binding DataContext.ProjectTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              Text="{Binding OnlyForProjectType, UpdateSourceTrigger=LostFocus}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>

                        <!-- Title block -->
                        <TabItem Header="Title block">
                            <DockPanel Margin="12">
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8" TextWrapping="Wrap">
                                    What goes on each line of your title block. In your title block drawing, either tag the attributes with these
                                    names (LINE1, LINE2 ... JOB_NO, COPYRIGHT) or type the placeholder, e.g. [[LINE2]], where the text should go.
                                    <LineBreak/><LineBreak/>
                                    Values can use any answer, e.g. [[PROJECT_NAME]], plus: [[PROJECT_NAME_1]] / [[PROJECT_NAME_2]] (a long name split
                                    over two lines), [[ADDRESS_1]] (street) / [[ADDRESS_2]] (city, state ZIP, everything after the first comma), [[YEAR]]
                                    (year of the project date). Every answer has _1 / _2 versions.
                                </TextBlock>
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Add line" Click="AddTitleLine_Click"/>
                                        <Button Content="Remove selected" Margin="8,0,0,0" Click="RemoveTitleLine_Click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="Split long answers after  " VerticalAlignment="Center"/>
                                        <TextBox Width="50" Text="{Binding Profile.WrapLength}"/>
                                        <TextBlock Text="  characters" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid x:Name="TitleGrid" ItemsSource="{Binding Profile.TitleBlockFields}" AutoGenerateColumns="False" CanUserAddRows="False"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E3E7EB"
                                          RowHeight="30" CellEditEnding="Grid_CellEditEnding">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tag / placeholder" Binding="{Binding Key}" Width="170" FontFamily="Consolas"/>
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" FontFamily="Consolas"/>
                                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>

                        <!-- Questions -->
                        <TabItem Header="Questions">
                            <DockPanel Margin="12">
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8" TextWrapping="Wrap"
                                           Text="The details asked for each new project. The key is the placeholder name: key PROJECT_NAME is written [[PROJECT_NAME]] in folder names, file names and drawings. Options are separated by semicolons and appear as a drop-down. Default value {today} is today's date. A date format (e.g. MM/dd/yyyy) makes the answer a date and writes it that way."/>
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Add question" Click="AddField_Click"/>
                                        <Button Content="Remove selected" Margin="8,0,0,0" Click="RemoveField_Click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="Placeholder format:  start " VerticalAlignment="Center"/>
                                        <TextBox Width="50" Text="{Binding Profile.TokenPrefix}"/>
                                        <TextBlock Text="  end " VerticalAlignment="Center"/>
                                        <TextBox Width="50" Text="{Binding Profile.TokenSuffix}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid x:Name="FieldsGrid" ItemsSource="{Binding Profile.Fields}" AutoGenerateColumns="False" CanUserAddRows="False"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E3E7EB"
                                          RowHeight="30" CellEditEnding="Grid_CellEditEnding">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="160" FontFamily="Consolas"/>
                                        <DataGridTextColumn Header="Question" Binding="{Binding Label}" Width="*"/>
                                        <DataGridTextColumn Header="Options (a; b; c)" Binding="{Binding Options}" Width="1.5*"/>
                                        <DataGridTextColumn Header="Default" Binding="{Binding DefaultValue}" Width="110"/>
                                        <DataGridTextColumn Header="Date format" Binding="{Binding Format}" Width="100"/>
                                        <DataGridCheckBoxColumn Header="Required" Binding="{Binding Required, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>

                        <!-- AutoCAD -->
                        <TabItem Header="AutoCAD">
                            <StackPanel Margin="12" MaxWidth="700" HorizontalAlignment="Left">
                                <TextBlock Text="AutoCAD Core Console (accoreconsole.exe)" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Installed with full AutoCAD (and AutoCAD Architecture etc.). SetArch uses it to fill in drawings without opening the AutoCAD window. Leave blank to find it automatically."/>
                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0" Click="BrowseConsole_Click"/>
                                    <TextBox Text="{Binding AutoCadConsolePath, UpdateSourceTrigger=PropertyChanged}" MaxWidth="10000"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="{Binding ConsoleStatus}" Margin="0,6,0,0"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,16,0,0"
                                           Text="AutoCAD LT doesn't include the Core Console. With LT, tick 'Also save a SetArch Fill.lsp' on the New project page, then in each drawing APPLOAD that file and type SETARCHFILL (LT 2024 or newer)."/>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
